; Prototype domains for the in-process Linux service tests.
(handleunknown deny)
(mls true)
(sensitivity s0)
(sensitivityorder (s0))
(role r)
(role object_r)
(user u)
(userrole u r)
(userrole u object_r)
(userlevel u (s0))
(userrange u ((s0) (s0)))
(type nce_t)
(type nce_service)
(type nce_denied)
(type nce_property)
(type properties_serial)
(typeattribute nce_all)
(typeattributeset nce_all (nce_t nce_service nce_denied nce_property properties_serial))
(roletype r nce_all)
(roletype object_r nce_all)
(allow nce_t nce_service (service_manager (add find list)))
(allow nce_t nce_t (service_manager (list)))
(allow nce_all nce_t (filesystem (associate)))
(fsuse trans tmpfs (u object_r nce_t ((s0) (s0))))
(fsuse task sockfs (u object_r nce_t ((s0) (s0))))
(fsuse task pipefs (u object_r nce_t ((s0) (s0))))
