+#ifdef ART_NCE
+static bool NceCompilerProfileEnabled() {
+  static const bool enabled = [] {
+    std::ifstream mode("/data/nce/art-compiler-profile");
+    return mode.get() == '1';
+  }();
+  return enabled;
+}
+
+static uint64_t NceCompilerProfileEpoch() {
+  static const uint64_t epoch = [] {
+    timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return static_cast<uint64_t>(now.tv_sec) * 1000000000ULL + now.tv_nsec;
+  }();
+  return epoch;
+}
+
+// One decision per graph. A rejection identifies the first unsupported IR,
+// while acceptance only means this filter allowed later code generation.
+static std::atomic<uint64_t> nce_filter_counts[HInstruction::kLastInstructionKind + 1];
+
+static const char* NceFilterKindName(size_t kind) {
+  switch (kind) {
+#define NCE_KIND_NAME(name, super) case HInstruction::k##name: return #name;
+    FOR_EACH_CONCRETE_INSTRUCTION(NCE_KIND_NAME)
+#undef NCE_KIND_NAME
+    default: return "accepted";
+  }
+}
+
+static void RecordNceCompilerFilter(HInstruction* rejected, const std::string& method) {
+  if (!NceCompilerProfileEnabled()) return;
+  const size_t kind = rejected ? rejected->GetKind() : HInstruction::kLastInstructionKind;
+  uint64_t count = nce_filter_counts[kind].fetch_add(1, std::memory_order_relaxed) + 1;
+  // Logarithmic reports bound log volume. SIGQUIT provides a complete snapshot.
+  if ((count & (count - 1)) == 0) {
+    LOG(INFO) << "NCE_ART_FILTER pid=" << getpid() << " epoch=" << NceCompilerProfileEpoch() << " kind=" << NceFilterKindName(kind)
+              << " count=" << count << (count <= 2 ? " method=" + method : "");
+  }
+}
+
+void DumpNceCompilerProfile(std::ostream& os) {
+  if (!NceCompilerProfileEnabled()) return;
+  for (size_t kind = 0; kind <= HInstruction::kLastInstructionKind; ++kind) {
+    uint64_t count = nce_filter_counts[kind].load(std::memory_order_relaxed);
+    if (count) os << "NCE_ART_FILTER_SUMMARY pid=" << getpid()
+                  << " epoch=" << NceCompilerProfileEpoch() << " kind=" << NceFilterKindName(kind) << " count=" << count << '\n';
+  }
+}
+#endif
