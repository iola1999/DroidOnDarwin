+/* Keep the resize policy available for ablation of stride conflicts. */
+static unsigned husk_tlb_min_bits(void)
+{
+#if defined(CONFIG_HUSK_ARM64_EXEC) && defined(TARGET_AARCH64)
+    static gsize initialized;
+    static unsigned bits = CPU_TLB_DYN_MIN_BITS;
+    if (g_once_init_enter(&initialized)) {
+        const char *setting = getenv("HUSK_ARM64_TLB_MIN_BITS");
+        if (setting) {
+            char *end;
+            unsigned long value = strtoul(setting, &end, 10);
+            if (!*setting || *end || value < CPU_TLB_DYN_MIN_BITS || value > 14) {
+                error_report("HUSK_ARM64_TLB_MIN_BITS must be 6..14");
+                exit(EXIT_FAILURE);
+            }
+            bits = value;
+            fprintf(stderr, "[husk-tlb] minimum entries=%u\n", 1u << bits);
+        }
+        g_once_init_leave(&initialized, 1);
+    }
+    return bits;
+#else
+    return CPU_TLB_DYN_MIN_BITS;
+#endif
 }
 
