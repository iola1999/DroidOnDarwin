+#if defined(CONFIG_HUSK_ARM64_EXEC) && !defined(CONFIG_USER_ONLY)
+uint64_t tb_husk_code_version(void *host)
+{
+    static uint64_t serial;
+    ram_addr_t address = qemu_ram_addr_from_host(host);
+    if (address == RAM_ADDR_INVALID) {
+        return 0;
+    }
+    PageDesc *p = page_find_alloc(address >> TARGET_PAGE_BITS, true);
+    page_lock(p);
+    if (!p->husk_version) {
+        /* Existing TLB write aliases must start observing code invalidation.
+         * The caller is the single vCPU admitted by the Direct backend. */
+        tlb_protect_code(address & TARGET_PAGE_MASK);
+        p->husk_version = ++serial;
+    }
+    uint64_t version = p->husk_version;
+    page_unlock(p);
+    return version;
+}
+#endif
