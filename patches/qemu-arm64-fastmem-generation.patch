--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -48,6 +48,25 @@
 #endif
 #include "tcg/tcg-ldst.h"
 
+#ifdef CONFIG_HUSK_ARM64_EXEC
+/* Direct's retained RAM aliases must observe TLB and dirty-tracking changes.
+ * The experimental backend admits one vCPU; atomic access also covers dirty
+ * resets requested by an I/O thread. */
+static uint64_t husk_mapping_generation = 1;
+
+uint64_t tlb_husk_mapping_generation(void)
+{
+    return qatomic_read(&husk_mapping_generation);
+}
+
+static void tlb_husk_mapping_changed(void)
+{
+    qatomic_inc(&husk_mapping_generation);
+}
+#else
+static inline void tlb_husk_mapping_changed(void) {}
+#endif
+
 /* DEBUG defines, enable DEBUG_TLB_LOG to log to the CPU_LOG_MMU target */
 /* #define DEBUG_TLB */
 /* #define DEBUG_TLB_LOG */
@@ -365,6 +384,7 @@
 
 static void tlb_flush_by_mmuidx_async_work(CPUState *cpu, run_on_cpu_data data)
 {
+    tlb_husk_mapping_changed();
     uint16_t asked = data.host_int;
     uint16_t all_dirty, work, to_clean;
     int64_t now = get_clock_realtime();
@@ -532,6 +552,7 @@
 
     assert_cpu_is_self(cpu);
 
+    tlb_husk_mapping_changed();
     tlb_debug("page addr: %016" VADDR_PRIx " mmu_map:0x%x\n", addr, idxmap);
 
     qemu_spin_lock(&cpu->neg.tlb.c.lock);
@@ -721,6 +742,7 @@
 
     assert_cpu_is_self(cpu);
 
+    tlb_husk_mapping_changed();
     tlb_debug("range: %016" VADDR_PRIx "/%u+%016" VADDR_PRIx " mmu_map:0x%x\n",
               d.addr, d.bits, d.len, d.idxmap);
 
@@ -853,6 +875,7 @@
    can be detected */
 void tlb_protect_code(ram_addr_t ram_addr)
 {
+    tlb_husk_mapping_changed();
     cpu_physical_memory_test_and_clear_dirty(ram_addr & TARGET_PAGE_MASK,
                                              TARGET_PAGE_SIZE,
                                              DIRTY_MEMORY_CODE);
@@ -914,6 +937,7 @@
  */
