+#ifdef CONFIG_HUSK_ARM64_EXEC
+uint64_t arm_husk_branch_pc(CPUARMState *env, uint64_t value)
+{
+    int tbi = EX_TBFLAG_A64(env->hflags, TBII);
+    if (!tbi) return value;
+    if (!regime_has_2_ranges(arm_mmu_idx(env))) {
+        return extract64(value, 0, 56);
+    }
+    uint64_t extended = sextract64(value, 0, 56);
+    switch (tbi) {
+    case 1: return extended & value;
+    case 2: return extended | value;
+    default: return extended;
+    }
+}
+
+void arm_husk_branch(CPUARMState *env, unsigned reg, bool link)
+{
+    uint64_t target = reg == 31 ? 0 : env->xregs[reg];
+    if (cpu_isar_feature(aa64_bti, env_archcpu(env))) {
+        if (link) {
+            env->btype = 2;
+        } else if (reg == 16 || reg == 17) {
+            env->btype = 1;
+        } else {
+            /* The caller synchronized the branch PC before this faultable probe. */
+            env->btype = is_guarded_page(env, env->pc, 0) ? 3 : 1;
+        }
+    }
+    if (link) env->xregs[30] = env->pc + 4;
+    env->pc = arm_husk_branch_pc(env, target);
+}
+#endif
