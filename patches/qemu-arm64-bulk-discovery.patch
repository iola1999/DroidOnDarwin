--- a/hw/arm/virt.c
+++ b/hw/arm/virt.c
@@ -300,6 +300,15 @@
 
     /* /chosen must exist for load_dtb to fill in necessary properties later */
     qemu_fdt_add_subnode(fdt, "/chosen");
+#ifdef CONFIG_HUSK_ARM64_EXEC
+    /* Only advertise the guest ABI when this accelerator implements it. */
+    const char *husk_bulk = getenv("HUSK_ARM64_BULK");
+    if (tcg_enabled() && ms->smp.cpus == 1 && husk_bulk &&
+        !strcmp(husk_bulk, "1")) {
+        qemu_fdt_setprop_string(fdt, "/chosen", "husk,bulk-memory", "1");
+    }
+#endif
+
     if (vms->dtb_randomness) {
         create_randomness(ms, "/chosen");
     }
