+/* Reuse QEMU's per-vCPU jump cache, including its existing TLB and code
+ * invalidation. EL1 register branches keep hflags unchanged except BTYPE. */
+static bool gen_husk_kernel_lookup(DisasContext *s)
+{
+#if defined(CONFIG_HUSK_ARM64_EXEC) && !defined(CONFIG_USER_ONLY) && TCG_TARGET_REG_BITS == 64
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *setting = getenv("HUSK_ARM64_TCG_INLINE_LOOKUP");
+        const char *kernel = getenv("HUSK_ARM64_KERNEL");
+        const char *direct = getenv("HUSK_ARM64_EXEC");
+        enabled = setting && !strcmp(setting, "1") &&
+                  !(kernel && !strcmp(kernel, "1") && direct && !strcmp(direct, "1"));
+        if (enabled) {
+            fprintf(stderr, "[husk-tcg] inline EL1 jump lookup active\n");
+        }
+    }
+    uint32_t cflags = s->base.tb->cflags;
+    if (!enabled || s->current_el != 1 || s->ss_active ||
+        (cflags & ~(CF_PCREL | CF_CLUSTER_MASK))) {
+        return false;
+    }
+    TCGLabel *slow = gen_new_label();
+    TCGv_i32 check = tcg_temp_new_i32();
+    TCGv_i64 hash = tcg_temp_new_i64();
+    TCGv_i64 value = tcg_temp_new_i64();
+    TCGv_i64 expected = tcg_temp_new_i64();
+    TCGv_ptr entry = tcg_temp_new_ptr();
+    TCGv_ptr tb = tcg_temp_new_ptr();
+#define CPU_OFFSET(field) ((intptr_t)offsetof(ARMCPU, parent_obj.field) - offsetof(ARMCPU, env))
+    /* Debugger and logging controls can change while the TB remains cached. */
+    tcg_gen_ld_i32(check, tcg_env, CPU_OFFSET(singlestep_enabled));
+    tcg_gen_brcondi_i32(TCG_COND_NE, check, 0, slow);
+    tcg_gen_ld8u_i32(check, tcg_constant_ptr(&one_insn_per_tb), 0);
+    tcg_gen_brcondi_i32(TCG_COND_NE, check, 0, slow);
+    tcg_gen_ld_i32(check, tcg_constant_ptr(&qemu_loglevel), 0);
+    tcg_gen_andi_i32(check, check, CPU_LOG_TB_CPU | CPU_LOG_EXEC | CPU_LOG_TB_NOCHAIN);
+    tcg_gen_brcondi_i32(TCG_COND_NE, check, 0, slow);
+    tcg_gen_ld_ptr(entry, tcg_env, CPU_OFFSET(breakpoints.tqh_first));
+    tcg_gen_brcondi_ptr(TCG_COND_NE, entry, 0, slow);
+    tcg_gen_ld_i32(check, tcg_env, CPU_OFFSET(tcg_cflags));
+    tcg_gen_brcondi_i32(TCG_COND_NE, check, cflags, slow);
+
+    tcg_gen_shri_i64(hash, cpu_pc, TARGET_PAGE_BITS - TB_JMP_PAGE_BITS);
+    tcg_gen_xor_i64(hash, hash, cpu_pc);
+    tcg_gen_shri_i64(value, hash, TARGET_PAGE_BITS - TB_JMP_PAGE_BITS);
+    tcg_gen_andi_i64(value, value, TB_JMP_PAGE_MASK);
+    tcg_gen_andi_i64(hash, hash, TB_JMP_ADDR_MASK);
+    tcg_gen_or_i64(hash, hash, value);
+    QEMU_BUILD_BUG_ON(sizeof(((CPUJumpCache *)0)->array[0]) != 16);
+    tcg_gen_shli_i64(hash, hash, 4);
+    tcg_gen_ld_ptr(entry, tcg_env, CPU_OFFSET(tb_jmp_cache));
+    tcg_gen_trunc_i64_ptr(tb, hash);
+    tcg_gen_add_ptr(entry, entry, tb);
+    /* Aligned host pointer loads have the same relaxed atomicity as the C
+     * lookup. Only this vCPU writes PCs; invalidators clear the TB pointer. */
+    tcg_gen_ld_ptr(tb, entry, offsetof(CPUJumpCache, array[0].tb));
+    tcg_gen_brcondi_ptr(TCG_COND_EQ, tb, 0, slow);
+    tcg_gen_ld_i64(value, entry, offsetof(CPUJumpCache, array[0].pc));
+    tcg_gen_brcond_i64(TCG_COND_NE, value, cpu_pc, slow);
+    tcg_gen_ld_i32(check, tb, offsetof(TranslationBlock, flags));
+    tcg_gen_brcondi_i32(TCG_COND_NE, check, s->base.tb->flags, slow);
+    tcg_gen_ld_i32(check, tcg_env, offsetof(CPUARMState, btype));
+    tcg_gen_extu_i32_i64(expected, check);
+    tcg_gen_shli_i64(expected, expected, R_TBFLAG_A64_BTYPE_SHIFT);
+    tcg_gen_ori_i64(expected, expected, s->base.tb->cs_base & ~R_TBFLAG_A64_BTYPE_MASK);
+    tcg_gen_ld_i64(value, tb, offsetof(TranslationBlock, cs_base));
+    tcg_gen_brcond_i64(TCG_COND_NE, value, expected, slow);
+    tcg_gen_ld_i32(check, tb, offsetof(TranslationBlock, cflags));
+    tcg_gen_brcondi_i32(TCG_COND_NE, check, cflags, slow);
+    tcg_gen_ld_ptr(tb, tb, offsetof(TranslationBlock, tc.ptr));
+    tcg_gen_goto_ptr(tb);
+    gen_set_label(slow);
+    tcg_gen_lookup_and_goto_ptr();
+#undef CPU_OFFSET
+    return true;
+#else
+    return false;
+#endif
+}
