#!/usr/bin/env bash
# 部分暂存的文件交由提交者处理，防止自动重新暂存扩大提交范围。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

FILES=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.c|*.h|*.cc|*.cpp|*.hpp|*.m|*.mm|*.swift)
            if [ -f "$file" ] && [ ! -L "$file" ]; then
                FILES+=("$file")
            fi
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[ "${#FILES[@]}" -gt 0 ] || exit 0

for file in "${FILES[@]}"; do
    if ! git --literal-pathspecs diff --quiet -- "$file"; then
        printf '暂存文件还有未暂存修改，已中止自动格式化：%s\n' "$file" >&2
        echo "请先完成该文件的修改与暂存，或将它移出本次提交。" >&2
        exit 1
    fi
done

GIT_LITERAL_PATHSPECS=1 bash scripts/format.sh -- "${FILES[@]}"
git --literal-pathspecs add -- "${FILES[@]}"
