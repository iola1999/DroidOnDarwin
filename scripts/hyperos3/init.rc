# SwiftShader 的启动预编译在 TCG 下耗时很长，绘制时按需编译。
on init
    setprop service.sf.prime_shader_cache 0

# 与 Husk 的 5599 端口协议一致，命令以 Android shell 身份执行。
service husk_agent /system/bin/sh -c "while true; do /system/bin/nc -L -p 5599 /system/bin/sh; sleep 2; done"
    class late_start
    user shell
    group shell log inet sdcard_rw
    seclabel u:r:shell:s0

on property:sys.boot_completed=1
    start husk_agent
    exec u:r:shell:s0 shell shell -- /system/bin/settings put global device_provisioned 1
    exec u:r:shell:s0 shell shell -- /system/bin/settings put secure user_setup_complete 1
    setprop sys.usb.config adb
